{
  "name": "solitaire-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server:dev": "tsx watch server/src/index.ts",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=server/dist/server.cjs",
    "server:start": "node server/dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "dev:all": "npm run server:dev & npm run dev -- --host; wait"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
